<% content_for :title, "Profile Settings" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Profile</h1>
    <p class="page-subtitle">Manage your personal information and account details.</p>
  </div>
</div>

<div class="page-content">
  <%= form_with model: @user, url: settings_profile_path, method: :patch, html: { class: "space-y-5" } do |f| %>

    <% if @user.errors.any? %>
      <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4" role="alert">
        <p class="text-red-600 dark:text-red-400 font-medium text-sm mb-2">Please fix the following errors:</p>
        <ul class="list-disc list-inside text-red-700 dark:text-red-300 text-sm space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Avatar -->
    <div class="card p-6" data-controller="cover-preview image-upload">
      <p class="form-label">Avatar</p>
      <div class="flex items-start gap-5 mt-2">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-violet-400 to-indigo-500 flex items-center justify-center text-white text-2xl font-semibold shrink-0 overflow-hidden">
          <% if @user.avatar_url.present? %>
            <img data-cover-preview-target="image" data-image-upload-target="image" src="<%= @user.avatar_url %>" alt="Avatar" class="w-full h-full object-cover">
          <% else %>
            <span><%= @user.name.to_s[0].to_s.upcase %></span>
          <% end %>
        </div>
        <div class="flex-1">
          <div data-image-upload-target="dropzone"
               class="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-4 text-center cursor-pointer hover:border-violet-400 dark:hover:border-violet-500 transition-colors"
               data-action="click->image-upload#pickFile">
            <p class="text-sm text-gray-600 dark:text-gray-400">Drag &amp; drop an avatar, or <span class="text-violet-600 dark:text-violet-400 underline">browse</span></p>
            <p class="text-xs text-gray-500 mt-1">Square images work best · up to 10 MB</p>
            <input type="file" accept="image/*" class="hidden"
                   data-image-upload-target="fileInput"
                   data-action="change->image-upload#fileChosen">
          </div>
          <div data-image-upload-target="spinner" class="hidden text-sm text-violet-600 dark:text-violet-400 mt-2">Uploading…</div>
          <div data-image-upload-target="error"   class="hidden text-sm text-red-500 dark:text-red-400 mt-2"></div>
          <%= f.url_field :avatar_url,
                class: "form-input mt-3",
                placeholder: "Or paste a URL",
                data: { cover_preview_target: "input", image_upload_target: "urlField", action: "input->cover-preview#input" } %>
        </div>
      </div>
    </div>

    <!-- Profile fields -->
    <div class="card p-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="form-group">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-input", required: true, maxlength: 120 %>
        </div>

        <div class="form-group">
          <%= f.label :username, class: "form-label" %>
          <%= f.text_field :username, class: "form-input font-mono", required: true, maxlength: 50,
              pattern: "[a-z0-9][a-z0-9-]*", title: "Lowercase letters, numbers, and hyphens only" %>
          <p class="form-hint">Your public blog lives at <code class="text-violet-600 dark:text-violet-400"><%= @user.username %>.<%= request.domain || "myblog" %><%= request.port == 80 || request.port == 443 ? "" : ":#{request.port}" %>/blog/…</code></p>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :bio, class: "form-label" %>
        <%= f.text_area :bio, class: "form-input", rows: 3, placeholder: "A short bio shown on your blog posts." %>
      </div>

      <div class="form-group">
        <%= f.label :website_url, "Website URL", class: "form-label" %>
        <%= f.url_field :website_url, class: "form-input", placeholder: "https://…" %>
      </div>
    </div>

    <!-- Email & password -->
    <div class="card p-6 space-y-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Email</h3>
      <p class="text-xs text-gray-500">Changing your email requires your current password and triggers a re-confirmation.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-input", value: @user.email %>
        </div>

        <div class="form-group">
          <%= f.label :current_password, "Current password (required when changing email)", class: "form-label" %>
          <div class="relative" data-controller="password-toggle">
            <%= f.password_field :current_password,
                  class: "form-input pr-11",
                  autocomplete: "current-password",
                  data: { password_toggle_target: "input" } %>
            <button type="button"
                    class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-500 dark:text-gray-400 hover:text-violet-600 dark:hover:text-violet-400 focus:outline-none focus:text-violet-600 dark:focus:text-violet-400"
                    data-action="password-toggle#toggle"
                    aria-label="Show or hide password"
                    tabindex="-1">
              <svg data-password-toggle-target="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <svg data-password-toggle-target="eyeClosed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <p class="text-xs text-gray-500">
        Role: <span class="text-gray-700 dark:text-gray-300 capitalize"><%= @user.role %></span> ·
        Joined <%= @user.created_at.strftime("%b %d, %Y") %>
      </p>
      <%= f.submit "Save Profile", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
