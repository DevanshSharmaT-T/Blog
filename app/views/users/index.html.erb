<% content_for :title, "Users" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Users</h1>
    <p class="page-subtitle"><%= pluralize(@pagy.count, "user") %> total</p>
  </div>
</div>

<div class="page-content">
  <%= search_form_for @q, url: users_path, html: { class: "mb-5" } do |s| %>
    <div class="flex items-center gap-3">
      <div class="flex-1 min-w-0">
        <%= s.search_field :name_or_email_cont,
              class: "form-input",
              placeholder: "Search by name or email…",
              "aria-label": "Search users" %>
      </div>
      <div class="w-44 shrink-0">
        <%= s.select :role_eq,
              options_for_select(
                [["All roles", ""], ["Owner", "owner"], ["Admin", "admin"], ["User", "user"], ["Visitor", "visitor"]],
                params.dig(:q, :role_eq)
              ),
              {}, class: "form-input" %>
      </div>
      <div class="w-44 shrink-0">
        <%= select_tag :status,
              options_for_select(
                [["Active accounts", ""], ["Unverified", "unverified"], ["Deleted", "deleted"]],
                params[:status]
              ),
              class: "form-input" %>
      </div>
      <%= s.submit "Filter", class: "btn btn-secondary shrink-0" %>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-gray-900/50 text-xs uppercase text-gray-500 tracking-wider">
        <tr>
          <th class="text-left px-4 py-3">User</th>
          <th class="text-left px-4 py-3">Role</th>
          <th class="text-left px-4 py-3">Status</th>
          <th class="text-left px-4 py-3">Last Login</th>
          <th class="text-left px-4 py-3">Joined</th>
          <th class="text-right px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/40 transition-colors">
            <td class="px-4 py-3">
              <%= link_to user_path(user), class: "flex items-center gap-3 group" do %>
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-400 to-indigo-500 flex items-center justify-center text-white text-xs font-semibold shrink-0 overflow-hidden">
                  <% if user.avatar_url.present? %>
                    <img src="<%= user.avatar_url %>" alt="" class="w-full h-full object-cover">
                  <% else %>
                    <%= user.name.to_s[0].to_s.upcase %>
                  <% end %>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors"><%= user.name %></p>
                  <p class="text-xs text-gray-500"><%= user.email %></p>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% color = { "owner" => "violet", "admin" => "amber", "user" => "emerald", "visitor" => "gray" }[user.role] %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-500/10 text-<%= color %>-400 capitalize">
                <%= user.role %>
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex flex-col gap-1 items-start">
                <% if user.deleted? %>
                  <span class="badge badge-error">Deleted</span>
                <% elsif user.is_active %>
                  <span class="text-emerald-400 text-xs">● Active</span>
                <% else %>
                  <span class="text-gray-500 text-xs">● Inactive</span>
                <% end %>
                <% if user.verified? %>
                  <span class="badge badge-active">Verified</span>
                <% else %>
                  <span class="badge badge-inactive">Unverified</span>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
              <%= user.last_login_at ? time_ago_in_words(user.last_login_at) + " ago" : "—" %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
              <%= user.created_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-4 py-3 text-right">
              <%# Self-rows and (for non-owners) owner-rows can't be managed — mirrors guard_target! %>
              <% manageable = user != current_user && (current_user.owner_role? || !user.owner_role?) %>
              <div class="inline-flex items-center gap-2">
                <% if manageable && can?(:change_role, user) %>
                  <%= form_with url: change_role_user_path(user), method: :patch, local: true,
                                class: "inline", data: { controller: "auto-submit" } do |fr| %>
                    <%= fr.select :role,
                          options_for_select(
                            (current_user.owner_role? ? [["Owner", "owner"]] : []) +
                            [["Admin", "admin"], ["User", "user"], ["Visitor", "visitor"]],
                            user.role
                          ),
                          {}, class: "form-input text-xs py-1 w-24",
                              "data-action": "change->auto-submit#submit" %>
                  <% end %>
                <% end %>

                <% show_menu = manageable && (user.deleted? ? can?(:restore, user) : true) %>
                <% if show_menu %>
                  <div class="relative inline-block text-left" data-controller="dropdown">
                    <button type="button"
                            class="btn btn-secondary text-xs py-1 px-2"
                            data-action="dropdown#toggle"
                            aria-haspopup="true" aria-label="User actions">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                      </svg>
                    </button>
                    <div data-dropdown-target="menu" hidden
                         class="absolute right-0 mt-1 w-52 z-20 origin-top-right rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-lg py-1 text-left">
                      <% menu_item = "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800" %>
                      <% danger_item = "block w-full text-left px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10" %>

                      <% unless user.deleted? %>
                        <% if user.verified? %>
                          <% if can?(:unverify, user) %>
                            <%= button_to "Mark unverified", unverify_user_path(user), method: :patch, class: menu_item %>
                          <% end %>
                        <% else %>
                          <% if can?(:verify, user) %>
                            <%= button_to "Mark verified", verify_user_path(user), method: :patch, class: menu_item %>
                          <% end %>
                          <% if can?(:resend_confirmation, user) %>
                            <%= button_to "Resend confirmation", resend_confirmation_user_path(user), method: :post, class: menu_item %>
                          <% end %>
                        <% end %>

                        <% if can?(:send_password_reset, user) %>
                          <%= button_to "Send password reset", send_password_reset_user_path(user), method: :post, class: menu_item %>
                        <% end %>

                        <% if can?(:toggle_active, user) %>
                          <%= button_to (user.is_active ? "Deactivate" : "Activate"),
                                toggle_active_user_path(user), method: :patch, class: menu_item %>
                        <% end %>

                        <% if can?(:destroy, user) %>
                          <%= button_to "Delete", user_path(user), method: :delete,
                                data: { turbo_confirm: "Soft-delete this user? They will be unable to sign in." },
                                class: danger_item %>
                        <% end %>
                      <% else %>
                        <% if can?(:restore, user) %>
                          <%= button_to "Restore", restore_user_path(user), method: :patch, class: menu_item %>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @users.empty? %>
      <div class="p-10 text-center text-gray-500 text-sm">No users match your filters.</div>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="mt-5">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
