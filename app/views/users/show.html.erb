<% content_for :title, @user.name %>

<div class="page-header">
  <div class="flex items-center gap-4">
    <div class="w-14 h-14 rounded-full bg-gradient-to-br from-violet-400 to-indigo-500 flex items-center justify-center text-white text-xl font-semibold shrink-0 overflow-hidden">
      <% if @user.avatar_url.present? %>
        <img src="<%= @user.avatar_url %>" alt="" class="w-full h-full object-cover">
      <% else %>
        <%= @user.name.to_s[0].to_s.upcase %>
      <% end %>
    </div>
    <div>
      <h1 class="page-title"><%= @user.name %></h1>
      <p class="page-subtitle"><%= @user.email %></p>
    </div>
  </div>
  <%= link_to users_path, class: "btn btn-secondary" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
    Back to Users
  <% end %>
</div>

<div class="page-content max-w-4xl space-y-5">
  <!-- Profile card -->
  <div class="card p-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wider">Role</p>
        <% color = { "owner" => "violet", "admin" => "amber", "user" => "emerald", "visitor" => "gray" }[@user.role] %>
        <span class="inline-flex items-center mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-500/10 text-<%= color %>-400 capitalize">
          <%= @user.role %>
        </span>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wider">Status</p>
        <p class="text-sm mt-1 <%= @user.is_active ? 'text-emerald-400' : 'text-gray-500' %>">
          <%= @user.is_active ? "● Active" : "● Inactive" %>
        </p>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wider">Joined</p>
        <p class="text-sm text-gray-800 dark:text-gray-200 mt-1"><%= @user.created_at.strftime("%b %d, %Y") %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wider">Last Login</p>
        <p class="text-sm text-gray-800 dark:text-gray-200 mt-1">
          <%= @user.last_login_at ? time_ago_in_words(@user.last_login_at) + " ago" : "Never" %>
        </p>
      </div>
    </div>

    <% if @user.bio.present? %>
      <div class="mt-5 pt-5 border-t border-gray-200 dark:border-gray-800">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Bio</p>
        <p class="text-sm text-gray-700 dark:text-gray-300"><%= @user.bio %></p>
      </div>
    <% end %>

    <% if @user.website_url.present? %>
      <div class="mt-3">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Website</p>
        <%= link_to @user.website_url, @user.website_url, target: "_blank", rel: "noopener", class: "text-sm text-violet-600 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300" %>
      </div>
    <% end %>
  </div>

  <!-- Recent blogs -->
  <div class="card p-6">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Recent Blogs (<%= @user.blogs.not_deleted.count %>)</h2>
    <% if @blogs.empty? %>
      <p class="text-sm text-gray-500">No blogs yet.</p>
    <% else %>
      <div class="divide-y divide-gray-200 dark:divide-gray-800">
        <% @blogs.each do |blog| %>
          <div class="py-3 flex items-center justify-between">
            <div class="min-w-0">
              <% if blog.published_status? %>
                <%= link_to blog.title, public_blog_url_for(blog), class: "text-sm font-medium text-gray-900 dark:text-white hover:text-violet-600 dark:hover:text-violet-400 truncate block" %>
              <% else %>
                <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= blog.title %></p>
              <% end %>
              <p class="text-xs text-gray-500"><%= blog.created_at.strftime("%b %d, %Y") %></p>
            </div>
            <span class="badge-<%= blog.status %> shrink-0"><%= blog.status.capitalize %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Social connections -->
  <% if @user.user_socials.any? %>
    <div class="card p-6">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Connected Accounts</h2>
      <div class="space-y-2">
        <% @user.user_socials.includes(:social_platform).each do |s| %>
          <div class="flex items-center justify-between py-2">
            <p class="text-sm text-gray-800 dark:text-gray-200"><%= s.social_platform.name %></p>
            <p class="text-xs text-gray-500">@<%= s.handle %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
