<% content_for :title, "Dashboard" %>
<% content_for :meta_description, "Blog analytics and management dashboard" %>

<!-- Page header -->
<div class="page-header">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">
      Welcome back, <%= current_user.name %> · <%= Time.current.strftime("%A, %B %d") %>
      · <%= @site_wide ? "Site-wide overview" : "Your blogs" %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to new_blog_path, class: "btn btn-primary", aria: { label: "New Blog" } do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Blog
    <% end %>
  </div>
</div>

<div class="page-content space-y-8">

  <!-- Stat cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">

    <!-- Total Blogs -->
    <div class="stat-card animate-fade-up">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Blogs</p>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2"><%= @total_blogs %></p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        </div>
      </div>
    </div>

    <!-- Total Views -->
    <div class="stat-card animate-fade-up delay-75">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Views</p>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2"><%= number_with_delimiter(@total_views) %></p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </div>
      </div>
    </div>

    <!-- Avg SEO Score -->
    <div class="stat-card animate-fade-up delay-150">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Avg SEO Score</p>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2"><%= @avg_seo_score %><span class="text-lg text-gray-500">/100</span></p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
      </div>
    </div>

    <!-- Avg Promotion Score -->
    <div class="stat-card animate-fade-up delay-225">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Avg Promotion</p>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2"><%= @avg_promotion %><span class="text-lg text-gray-500">/100</span></p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Views chart -->
  <div class="card p-6 animate-fade-up delay-300">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Views — Last 30 Days</h2>
      <span class="text-xs text-gray-500">All blogs · Daily aggregate</span>
    </div>
    <%= line_chart @views_by_day,
        colors: ["#8b5cf6"],
        library: {
          curveType: "function",
          backgroundColor: "transparent",
          legend: { position: "none" },
          hAxis: { textStyle: { color: "#6b7280" }, gridlines: { color: "transparent" } },
          vAxis: { textStyle: { color: "#6b7280" }, gridlines: { color: "#1f2937" }, baselineColor: "#1f2937" },
          chartArea: { width: "95%", height: "80%" }
        },
        height: "280px" %>
  </div>

  <!-- Top blogs table -->
  <div class="card overflow-hidden animate-fade-up delay-375">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-800">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Top Blogs This Week</h2>
      <%= link_to "View all", blogs_path, class: "text-sm text-violet-600 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300" %>
    </div>
    <% if @top_blogs.any? %>
      <table class="data-table" aria-label="Top blogs by views">
        <thead>
          <tr>
            <th>Title</th>
            <th>Topics</th>
            <th class="text-right">SEO</th>
            <th class="text-right">Readability</th>
            <th class="text-right">Promotion</th>
            <th class="text-right">Trend</th>
          </tr>
        </thead>
        <tbody>
          <% @top_blogs.each do |blog| %>
            <tr>
              <td>
                <div class="flex flex-col">
                  <span class="font-medium text-gray-900 dark:text-white truncate max-w-xs"><%= blog.title %></span>
                  <span class="text-xs text-gray-500 mt-0.5">by <%= blog.author.name %></span>
                </div>
              </td>
              <td>
                <div class="flex flex-wrap gap-1">
                  <% blog.topics.first(2).each do |topic| %>
                    <span class="badge badge-published text-xs"><%= topic.name %></span>
                  <% end %>
                </div>
              </td>
              <td class="text-right">
                <span class="<%= blog.seo_score.to_i >= 60 ? 'text-emerald-400' : blog.seo_score.to_i >= 40 ? 'text-amber-400' : 'text-red-400' %> font-medium">
                  <%= blog.seo_score || '—' %>
                </span>
              </td>
              <td class="text-right">
                <span class="<%= blog.readability_score.to_i >= 60 ? 'text-emerald-400' : blog.readability_score.to_i >= 40 ? 'text-amber-400' : 'text-red-400' %> font-medium">
                  <%= blog.readability_score || '—' %>
                </span>
              </td>
              <td class="text-right">
                <span class="<%= blog.promotion_score.to_i >= 60 ? 'text-emerald-400' : blog.promotion_score.to_i >= 40 ? 'text-amber-400' : 'text-red-400' %> font-medium">
                  <%= blog.promotion_score || '—' %>
                </span>
              </td>
              <td class="text-right">
                <% trend = @trends[blog.id] %>
                <% if trend == :up %>
                  <span class="inline-flex items-center gap-1 text-emerald-400 text-xs" aria-label="Trending up">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                    Up
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 text-red-400 text-xs" aria-label="Trending down">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                    Down
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-12 text-center">
        <p class="text-gray-500">No published blogs yet this week.</p>
        <%= link_to "Create your first blog", new_blog_path, class: "btn btn-primary mt-4 mx-auto" %>
      </div>
    <% end %>
  </div>

</div>
