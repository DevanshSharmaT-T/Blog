<% content_for :title, "Topics" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Topics</h1>
    <p class="page-subtitle">Browse and manage content categories</p>
  </div>
  <% if user_signed_in? && (current_user.owner_role? || current_user.admin_role?) %>
    <%= link_to new_topic_path, class: "btn btn-primary" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Topic
    <% end %>
  <% end %>
</div>

<div class="page-content">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    <% @topics.each do |topic| %>
      <div class="card-hover p-5" style="--topic-color: <%= topic.color_hex || '#6366f1' %>;">
        <div class="flex items-start justify-between mb-3">
          <div class="topic-icon-tile">
            <span class="text-lg"><%= topic.icon_name ? "🏷️" : "📌" %></span>
          </div>
          <span class="text-xs" style="color: var(--color-fg-subtle);"><%= pluralize(topic.post_count, "post") %></span>
        </div>
        <h3 class="font-semibold mb-1" style="color: var(--color-fg);"><%= topic.name %></h3>
        <% if topic.description %>
          <p class="text-xs line-clamp-2 mb-3" style="color: var(--color-fg-muted);"><%= topic.description %></p>
        <% end %>
        <div class="flex items-center justify-between">
          <%= link_to topic_path(topic), class: "text-xs", style: "color: var(--color-accent);" do %>
            View posts →
          <% end %>
          <% if user_signed_in? && (current_user.owner_role? || current_user.admin_role?) %>
            <%= link_to edit_topic_path(topic), class: "text-xs", style: "color: var(--color-fg-subtle);" do %>
              Edit
            <% end %>
          <% end %>
        </div>
        <% if topic.sub_topics.any? %>
          <div class="mt-3 pt-3 flex flex-wrap gap-1" style="border-top: 1px solid var(--color-border);">
            <% topic.sub_topics.first(3).each do |sub| %>
              <span class="badge badge-inactive text-xs"><%= sub.name %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
