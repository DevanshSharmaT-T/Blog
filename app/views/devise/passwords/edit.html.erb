<% content_for :title, "Change Password" %>

<div class="min-h-screen flex bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100" data-controller="theme">
  <%= render "devise/shared/brand_panel" %>

  <section class="flex-1 lg:w-1/2 flex flex-col">
    <div class="flex items-center justify-between px-6 lg:px-10 py-5">
      <%= link_to root_path, class: "inline-flex items-center gap-2 lg:invisible" do %>
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-gradient-to-br from-violet-500 to-indigo-600">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
        </span>
        <span class="font-bold tracking-tight text-gray-900 dark:text-white">MyBlog</span>
      <% end %>
      <button type="button" class="theme-toggle" data-action="theme#toggle" aria-label="Toggle color theme">
        <svg class="icon-sun w-4 h-4"  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg class="icon-moon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
    </div>

    <div class="flex-1 flex items-center justify-center px-6 lg:px-10 py-10">
      <div class="w-full max-w-md">
        <div class="mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-violet-50 dark:bg-violet-500/10 border border-violet-200/70 dark:border-violet-500/20 mb-4 text-violet-600 dark:text-violet-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Change your password</h1>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Pick a strong password you'll remember.
          </p>
        </div>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                     html: { method: :put, class: "space-y-5" }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <%= render "devise/shared/password_field",
                f: f, field: :password, label: "New password",
                autocomplete: "new-password", autofocus: true,
                hint: (@minimum_password_length ? "Minimum #{@minimum_password_length} characters" : nil) %>

          <%= render "devise/shared/password_field",
                f: f, field: :password_confirmation, label: "Confirm new password",
                autocomplete: "new-password" %>

          <%= f.submit "Change my password", class: "btn btn-primary w-full justify-center py-3 text-base" %>
        <% end %>

        <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-800">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </section>
</div>
