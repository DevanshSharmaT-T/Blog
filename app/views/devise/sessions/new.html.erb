<% content_for :title, "Sign In" %>

<div class="min-h-screen bg-gray-950 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <!-- Brand header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 mb-4 animate-pulse-glow">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Welcome back</h1>
      <p class="text-gray-400 text-sm mt-1">Sign in to your MyBlog account</p>
    </div>

    <div class="card p-8 space-y-5">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                   html: { class: "space-y-5" }) do |f| %>

        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "form-input", placeholder: "you@example.com",
              aria: { label: "Email address" } %>
        </div>

        <div class="form-group">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password",
              class: "form-input", placeholder: "••••••••",
              aria: { label: "Password" } %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <%= f.check_box :remember_me, id: "remember_me",
                  class: "rounded border-gray-600 bg-gray-800 text-violet-600 focus:ring-violet-500" %>
              <%= f.label :remember_me, "Remember me", class: "text-sm text-gray-400" %>
            </div>
            <%= link_to "Forgot password?", new_password_path(resource_name),
                class: "text-sm text-violet-400 hover:text-violet-300" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Sign in", class: "btn-primary w-full justify-center py-3 text-base" %>
        </div>
      <% end %>

      <div class="pt-4 border-t border-gray-800 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
