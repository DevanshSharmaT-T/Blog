<%#
  Brand showcase panel for Devise split-screen layouts.
  Hidden below the lg breakpoint — auth pages render a small inline brand on mobile instead.
%>
<aside class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-violet-50 via-white to-indigo-50 dark:from-gray-950 dark:via-gray-900 dark:to-violet-950/40">
  <!-- decorative orbs -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-32 -right-24 w-96 h-96 rounded-full blur-3xl bg-violet-300/40 dark:bg-violet-600/20"></div>
    <div class="absolute top-1/3 -left-16 w-80 h-80 rounded-full blur-3xl bg-indigo-300/30 dark:bg-indigo-700/20"></div>
    <div class="absolute -bottom-24 right-1/4 w-96 h-96 rounded-full blur-3xl bg-fuchsia-300/25 dark:bg-fuchsia-700/15"></div>
  </div>

  <div class="relative z-10 flex flex-col justify-between p-12 xl:p-16 w-full">
    <!-- Brand mark -->
    <%= link_to root_path, class: "inline-flex items-center gap-3 group w-fit" do %>
      <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 shadow-lg shadow-violet-500/30 transition-transform group-hover:scale-105">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
        </svg>
      </span>
      <span class="text-xl font-extrabold tracking-tight text-gray-900 dark:text-white">MyBlog</span>
    <% end %>

    <!-- Centerpiece -->
    <div class="max-w-md">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-700 dark:text-violet-300 text-xs font-medium mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
        Writing, beautifully done
      </span>
      <h2 class="text-4xl xl:text-5xl font-extrabold tracking-tight leading-[1.05] text-gray-900 dark:text-white">
        Stories that
        <span class="block bg-clip-text text-transparent bg-gradient-to-r from-violet-500 via-indigo-500 to-fuchsia-500">deserve a stage.</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-gray-600 dark:text-gray-300">
        A modern publishing studio for writers who care about craft — drafts, templates,
        analytics, and a reader-first reading experience, all in one place.
      </p>

      <ul class="mt-8 space-y-3">
        <% [
          ["Editorial templates that read like magazines", "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"],
          ["SEO + readability scoring as you write", "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"],
          ["Webhooks and integrations for your stack", "M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"]
        ].each do |(text, path)| %>
          <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300">
            <span class="mt-0.5 inline-flex items-center justify-center w-6 h-6 rounded-lg bg-violet-500/10 text-violet-600 dark:text-violet-300 border border-violet-500/20 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="<%= path %>"/></svg>
            </span>
            <span><%= text %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Footer note -->
    <p class="text-xs text-gray-500 dark:text-gray-500">
      &copy; <%= Date.current.year %> MyBlog. Crafted for writers.
    </p>
  </div>
</aside>
