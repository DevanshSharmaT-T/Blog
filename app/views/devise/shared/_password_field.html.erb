<%#
  Locals:
    f             — form builder
    field         — :password / :password_confirmation / :current_password
    label         — visible label text
    autocomplete  — "current-password" | "new-password"
    placeholder   — defaults to "••••••••"
    hint          — optional small helper text rendered above the input
    autofocus     — optional, defaults to false
    validate      — optional, nil | :password | :match. Opts the field into the
                    interactive `field-validator` controller (the form must mount it).
                    :password adds length + strength feedback and a strength meter;
                    :match adds password-confirmation matching.
%>
<% placeholder ||= "••••••••" %>
<% hint        ||= nil %>
<% autofocus   ||= false %>
<% validate    ||= nil %>
<%
  validator_data =
    case validate
    when :password
      { field_validator_target: "input", field_validator_kind: "password",
        action: "input->field-validator#check blur->field-validator#check" }
    when :match
      { field_validator_target: "input", field_validator_kind: "confirmation",
        action: "input->field-validator#check blur->field-validator#check" }
    else
      {}
    end
%>

<div class="form-group">
  <%= f.label field, label, class: "form-label" %>
  <% if hint %>
    <p class="form-hint mb-1"><%= hint %></p>
  <% end %>
  <div class="relative" data-controller="password-toggle">
    <%= f.password_field field,
          autocomplete: autocomplete,
          autofocus: autofocus,
          class: "form-input pr-11",
          placeholder: placeholder,
          aria: { label: label },
          data: { password_toggle_target: "input" }.merge(validator_data) %>
    <button type="button"
            class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-500 dark:text-gray-400 hover:text-violet-600 dark:hover:text-violet-400 focus:outline-none focus:text-violet-600 dark:focus:text-violet-400"
            data-action="password-toggle#toggle"
            aria-label="Show or hide password"
            tabindex="-1">
      <svg data-password-toggle-target="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <svg data-password-toggle-target="eyeClosed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" hidden>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
      </svg>
    </button>
  </div>

  <% if validate == :password %>
    <div class="mt-2 flex items-center gap-2" aria-hidden="true">
      <div class="flex-1 h-1 rounded bg-gray-200 dark:bg-gray-700 overflow-hidden">
        <div class="h-full rounded bg-gray-300 transition-all duration-200" style="width: 0%" data-strength-bar></div>
      </div>
      <span class="text-xs text-gray-500 dark:text-gray-400 w-12 text-right" data-strength-label></span>
    </div>
  <% end %>

  <% if validate %>
    <p class="form-error hidden"></p>
  <% end %>
</div>
