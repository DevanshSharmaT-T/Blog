<% content_for :title, "Create Account" %>

<div class="min-h-screen bg-gray-950 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 mb-4">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Create your account</h1>
      <p class="text-gray-400 text-sm mt-1">Start publishing great content today</p>
    </div>

    <div class="card p-8 space-y-5">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                   html: { class: "space-y-5" }) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :name, "Full Name", class: "form-label" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "form-input", placeholder: "Jane Doe",
              aria: { label: "Full name", required: true } %>
        </div>

        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email",
              class: "form-input", placeholder: "you@example.com",
              aria: { label: "Email address", required: true } %>
        </div>

        <div class="form-group">
          <%= f.label :password, class: "form-label" %>
          <% if @minimum_password_length %>
            <p class="form-hint mb-1">Minimum <%= @minimum_password_length %> characters</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "form-input", placeholder: "••••••••",
              aria: { label: "Password", required: true } %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "form-input", placeholder: "••••••••",
              aria: { label: "Confirm password", required: true } %>
        </div>

        <div class="bg-violet-500/5 border border-violet-500/20 rounded-xl p-4">
          <p class="text-xs text-gray-400">
            By creating an account, you'll be able to write and publish blog posts. You'll receive a confirmation email to verify your account.
          </p>
        </div>

        <%= f.submit "Create Account", class: "btn-primary w-full justify-center py-3 text-base" %>
      <% end %>

      <div class="pt-4 border-t border-gray-800 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
