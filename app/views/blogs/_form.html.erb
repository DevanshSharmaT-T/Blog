<% content_for :title, @blog.present? ? "Edit: #{@blog.title}" : "New Blog" %>

<!-- Step progress bar -->
<% steps = [
  { key: :topics,   label: "Topics",   icon: "🏷️" },
  { key: :content,  label: "Content",  icon: "✍️" },
  { key: :template, label: "Template", icon: "🎨" },
  { key: :review,   label: "Review",   icon: "🚀" }
] %>
<% current_step = (@step || :topics) %>
<% step_index = steps.index { |s| s[:key] == current_step.to_sym } || 0 %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= @blog&.id ? "Edit Blog" : "Create Blog" %></h1>
    <p class="page-subtitle">Step <%= step_index + 1 %> of <%= steps.size %> — <%= steps[step_index][:label] %></p>
  </div>
  <% if @blog&.id %>
    <%= link_to blogs_path, class: "btn btn-secondary" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      Cancel
    <% end %>
  <% end %>
</div>

<!-- Step indicators -->
<div class="px-8 py-4 border-b border-gray-200 dark:border-gray-800">
  <div class="flex items-center gap-2">
    <% steps.each_with_index do |step, i| %>
      <%
        state_class = i < step_index ? 'step-done' : i == step_index ? 'step-active' : 'step-pending'
        label_class = i == step_index ? 'text-gray-900 dark:text-white font-medium' : 'text-gray-500'
        aria_state  = i < step_index ? 'done' : i == step_index ? 'current' : 'pending'
        aria_current = i == step_index ? 'step' : nil
      %>
      <% inner = capture do %>
        <div class="step-indicator <%= state_class %>"
             aria-label="Step <%= i + 1 %>: <%= step[:label] %> (<%= aria_state %>)">
          <% if i < step_index %>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <% else %>
            <%= i + 1 %>
          <% end %>
        </div>
        <span class="text-sm <%= label_class %>"><%= step[:label] %></span>
      <% end %>

      <% if @blog&.persisted? %>
        <%= link_to edit_blog_path(@blog, step: step[:key]),
              class: "flex items-center gap-2 rounded-lg px-1 -mx-1 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/50 transition-opacity",
              aria: { current: aria_current } do %>
          <%= inner %>
        <% end %>
      <% else %>
        <div class="flex items-center gap-2"><%= inner %></div>
      <% end %>

      <% if i < steps.length - 1 %>
        <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800 mx-2"></div>
      <% end %>
    <% end %>
  </div>
</div>

<div class="page-content">
  <%= form_with model: @blog,
      url: @blog&.id ? blog_path(@blog) : blogs_path,
      method: @blog&.id ? :patch : :post,
      html: { class: "space-y-6", id: "blog-form", data: { turbo: true } } do |f| %>

    <%= hidden_field_tag :step, current_step %>

    <% if @blog&.errors&.any? %>
      <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4" role="alert">
        <p class="text-red-600 dark:text-red-400 font-medium text-sm mb-2">Please fix the following errors:</p>
        <ul class="list-disc list-inside text-red-700 dark:text-red-300 text-sm space-y-1">
          <% @blog.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- STEP 1: Topics -->
    <% if current_step.to_sym == :topics %>
      <div class="card p-6 space-y-6">
        <div>
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">Choose Topics</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400">Select topics that best describe your blog post. At least 2 improves your promotion score.</p>
        </div>

        <!-- Title (collected on first step) -->
        <div class="form-group" data-controller="slug">
          <%= f.label :title, "Blog Title", class: "form-label" %>
          <%= f.text_field :title,
                class: "form-input",
                placeholder: "Enter a compelling title…",
                maxlength: 255,
                required: true,
                data: { slug_target: "titleInput", action: "input->slug#titleChanged" } %>
          <% if @blog.respond_to?(:slug) %>
            <%= f.hidden_field :slug, data: { slug_target: "slugInput", action: "input->slug#slugChanged" } %>
          <% end %>
          <p class="form-hint">URL preview: <code class="text-violet-600 dark:text-violet-400">/blog/<span data-slug-target="preview">your-slug-here</span></code></p>
        </div>

        <!-- Topics multi-select -->
        <div>
          <p class="form-label">Topics</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-2" id="topic-grid">
            <% (@topics || Topic.active.by_name).each do |topic| %>
              <label class="topic-chip">
                <input type="checkbox" name="blog[topic_ids][]" value="<%= topic.id %>"
                       id="topic_<%= topic.id %>"
                       <%= @selected_topic_ids&.include?(topic.id) ? 'checked' : '' %>
                       class="rounded border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-violet-600 focus:ring-violet-500">
                <div>
                  <div class="flex items-center gap-1.5 mb-1">
                    <span style="color: <%= topic.color_hex || '#6366f1' %>">
                      <%= topic_icon(topic.icon_name, class: "w-4 h-4") %>
                    </span>
                    <% if topic.color_hex %>
                      <span class="w-3 h-3 rounded-full inline-block" style="background-color: <%= topic.color_hex %>"></span>
                    <% end %>
                  </div>
                  <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= topic.name %></p>
                  <p class="text-xs text-gray-500"><%= pluralize(topic.post_count, 'post') %></p>
                </div>
              </label>
            <% end %>
          </div>
          <p class="form-hint mt-2">Can't find the right topic? <%= link_to "Create one", new_topic_path, class: "text-violet-600 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300", target: "_blank" %></p>
        </div>

        <div class="flex justify-end">
          <%= f.submit "Continue to Content →", class: "btn btn-primary" %>
        </div>
      </div>

    <!-- STEP 2: Content -->
    <% elsif current_step.to_sym == :content %>
      <div class="space-y-5">
        <!-- Title edit -->
        <div class="card p-5 form-group">
          <%= f.label :title, "Title", class: "form-label" %>
          <%= f.text_field :title, class: "form-input text-lg font-semibold", placeholder: "Blog title…", required: true %>
        </div>

        <!-- Excerpt -->
        <div class="card p-5 form-group">
          <%= f.label :excerpt, "Excerpt", class: "form-label" %>
          <%= f.text_area :excerpt, class: "form-input", rows: 3, placeholder: "A short teaser shown in listings…", id: "blog_excerpt" %>
          <p class="form-hint">Setting an excerpt adds +25 to your promotion score</p>
        </div>

        <!-- Content -->
        <div class="card p-5 form-group"
             data-controller="markdown-editor"
             data-markdown-editor-unique-id-value="<%= @blog.id || "new" %>">
          <div class="flex items-center justify-between mb-2">
            <%= f.label :content, "Content", class: "form-label mb-0" %>
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <span data-markdown-editor-target="wordCount">0 words</span>
              <span>·</span>
              <span data-markdown-editor-target="readTime">~0 min read</span>
            </div>
          </div>
          <!-- EasyMDE Markdown editor loaded from CDN -->
          <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
          <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
          <%= f.text_area :content,
                class: "form-input font-mono",
                rows: 20,
                id: "blog_content",
                placeholder: "Write your blog in Markdown…",
                data: { markdown_editor_target: "textarea" } %>
        </div>

        <!-- Cover image -->
        <div class="card p-5 form-group" data-controller="cover-preview image-upload">
          <%= f.label :cover_image_url, "Cover Image", class: "form-label" %>

          <!-- Drag & drop zone -->
          <div data-image-upload-target="dropzone"
               class="mt-2 mb-3 border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-6 text-center transition-colors cursor-pointer hover:border-violet-400 dark:hover:border-violet-500"
               data-action="click->image-upload#pickFile">
            <svg class="w-8 h-8 mx-auto text-gray-400 dark:text-gray-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.9 5 5 0 019.9-1A5.5 5.5 0 0118.5 16H7z"/></svg>
            <p class="text-sm text-gray-600 dark:text-gray-400">Drag &amp; drop an image, or <span class="text-violet-600 dark:text-violet-400 underline">browse</span></p>
            <p class="text-xs text-gray-500 mt-1">PNG, JPG, WebP up to 10 MB</p>
            <input type="file" accept="image/*" class="hidden"
                   data-image-upload-target="fileInput"
                   data-action="change->image-upload#fileChosen">
          </div>

          <div data-image-upload-target="spinner" class="hidden text-sm text-violet-600 dark:text-violet-400 mb-2">Uploading…</div>
          <div data-image-upload-target="error"   class="hidden text-sm text-red-500 dark:text-red-400 mb-2"></div>

          <%= f.url_field :cover_image_url,
                class: "form-input",
                placeholder: "https://… (or upload above)",
                id: "cover_image_url",
                data: {
                  cover_preview_target: "input",
                  image_upload_target:  "urlField",
                  action: "input->cover-preview#input"
                } %>
          <p class="form-hint">Setting a cover image adds +25 to SEO and promotion scores.</p>

          <div data-cover-preview-target="preview" class="mt-3 hidden">
            <img data-cover-preview-target="image" data-image-upload-target="image"
                 src="<%= @blog.cover_image_url %>"
                 alt="Cover preview"
                 class="w-full h-48 object-cover rounded-xl border border-gray-200 dark:border-gray-700">
          </div>
        </div>

        <!-- SEO fields -->
        <div class="card p-5 space-y-4">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white">SEO Settings</h3>

          <div class="form-group" data-controller="char-counter" data-char-counter-max-value="70">
            <%= f.label :seo_title, "SEO Title", class: "form-label" %>
            <%= f.text_field :seo_title,
                  class: "form-input",
                  placeholder: "30–60 characters recommended",
                  maxlength: 70,
                  id: "seo_title",
                  data: { char_counter_target: "input", action: "input->char-counter#input" } %>
            <p class="form-hint"><span data-char-counter-target="counter">0</span>/70 characters · 30–60 is optimal</p>
            <div class="mt-1 h-1 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
              <div data-char-counter-target="bar" class="h-full rounded-full bg-emerald-500 transition-all duration-150" style="width: 0%"></div>
            </div>
          </div>

          <div class="form-group" data-controller="char-counter" data-char-counter-max-value="160">
            <%= f.label :seo_description, "SEO Description", class: "form-label" %>
            <%= f.text_area :seo_description,
                  class: "form-input",
                  rows: 3,
                  placeholder: "120–160 characters for best results",
                  maxlength: 160,
                  id: "seo_desc",
                  data: { char_counter_target: "input", action: "input->char-counter#input" } %>
            <p class="form-hint"><span data-char-counter-target="counter">0</span>/160 characters · 120–160 is optimal</p>
            <div class="mt-1 h-1 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
              <div data-char-counter-target="bar" class="h-full rounded-full bg-emerald-500 transition-all duration-150" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <div class="flex justify-between">
          <%= link_to "← Back to Topics", edit_blog_path(@blog, step: :topics), class: "btn btn-secondary" %>
          <%= f.submit "Continue to Template →", class: "btn btn-primary" %>
        </div>
      </div>

    <!-- STEP 3: Template -->
    <% elsif current_step.to_sym == :template %>
      <%
        all_templates = @templates || Template.active.order(:category, :name)
        categories = ["all"] + all_templates.map(&:category).uniq.sort
      %>
      <div class="card p-6" data-controller="template-filter" data-template-filter-active-value="all">
        <div class="flex items-start justify-between mb-5 flex-wrap gap-3">
          <div>
            <h2 class="text-lg font-semibold mb-1" style="color: var(--color-fg);">Choose a Template</h2>
            <p class="text-sm" style="color: var(--color-fg-muted);">
              <%= all_templates.size %> templates. Each defines the visual style of your published post.
            </p>
          </div>
          <%= link_to "Browse full gallery →", templates_path, target: "_blank", rel: "noopener",
                class: "text-sm", style: "color: var(--color-accent);" %>
        </div>

        <!-- Category filter chips -->
        <nav class="reading-topics" style="margin-bottom: 1.5rem;" aria-label="Filter templates by category">
          <% categories.each do |cat| %>
            <button type="button"
                    class="topic-pill <%= 'active' if cat == 'all' %>"
                    data-template-filter-target="chip"
                    data-category="<%= cat %>"
                    data-action="template-filter#filter">
              <%= cat.capitalize %>
            </button>
          <% end %>
        </nav>

        <div class="template-grid" role="radiogroup" aria-label="Blog templates">
          <!-- No template / default -->
          <label class="template-card" data-template-filter-target="card" data-category="all">
            <input type="radio" name="blog[template_id]" value="" <%= 'checked' if @blog.template_id.nil? %>
                   class="sr-only" id="template_none">
            <div class="template-card-inner template-card-default">
              <div class="tpl-preview tpl-preview-card tpl tpl-medium-classic" aria-hidden="true">
                <div class="tpl-preview-title">Default</div>
                <div class="tpl-preview-deck">Plain content view — no template selected.</div>
                <div class="tpl-preview-byline">By you · Today</div>
                <div class="tpl-preview-body"><p>Same as Medium Classic, no extra styling.</p></div>
              </div>
              <div class="template-card-meta">
                <p class="template-card-name">No template</p>
                <p class="template-card-cat">Default look</p>
              </div>
            </div>
          </label>

          <% all_templates.each do |template| %>
            <label class="template-card"
                   data-template-filter-target="card"
                   data-category="<%= template.category %>">
              <input type="radio" name="blog[template_id]" value="<%= template.id %>"
                     <%= 'checked' if @blog.template_id == template.id %>
                     class="sr-only" id="template_<%= template.id %>">
              <div class="template-card-inner">
                <%= render "shared/template_preview", template: template, aspect: "card" %>
                <% if template.is_premium %>
                  <span class="template-premium-badge">Premium</span>
                <% end %>
                <div class="template-card-meta">
                  <p class="template-card-name"><%= template.name %></p>
                  <p class="template-card-cat"><%= template.category.capitalize %></p>
                </div>
              </div>
            </label>
          <% end %>
        </div>

        <div class="flex justify-between mt-6">
          <%= link_to "← Back to Content", edit_blog_path(@blog, step: :content), class: "btn btn-secondary" %>
          <%= f.submit "Continue to Review →", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>

  <% end %>

  <!-- STEP 4: Review & Publish — standalone block. Its publish / submit-review / schedule
       actions are their own forms and must NOT be nested inside the edit form above. -->
  <% if current_step.to_sym == :review %>
      <div class="space-y-5">
        <!-- Summary card -->
        <div class="card p-6 space-y-4">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Review & Publish</h2>

          <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
              <p class="text-gray-500">Title</p>
              <p class="text-gray-900 dark:text-white font-medium mt-0.5"><%= @blog.title %></p>
            </div>
            <div>
              <p class="text-gray-500">Status</p>
              <span class="badge-<%= @blog.status %> mt-0.5 inline-block"><%= @blog.status.capitalize %></span>
            </div>
            <div>
              <p class="text-gray-500">Word Count</p>
              <p class="text-gray-900 dark:text-white mt-0.5"><%= number_with_delimiter(@blog.word_count) %> words · ~<%= @blog.reading_time_mins %> min read</p>
            </div>
            <div>
              <p class="text-gray-500">Template</p>
              <p class="text-gray-900 dark:text-white mt-0.5"><%= @blog.template&.name || "Default" %></p>
            </div>
            <div>
              <p class="text-gray-500">Topics</p>
              <div class="flex flex-wrap gap-1 mt-0.5">
                <% @blog.topics.each do |t| %>
                  <span class="badge badge-published"><%= t.name %></span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Scores -->
        <div class="grid grid-cols-3 gap-4">
          <% [
            { label: "SEO Score", value: @blog.seo_score, color: "violet" },
            { label: "Readability", value: @blog.readability_score, color: "blue" },
            { label: "Promotion", value: @blog.promotion_score, color: "emerald" }
          ].each do |score| %>
            <div class="card p-5 text-center">
              <div class="text-3xl font-bold text-<%= score[:color] %>-400">
                <%= score[:value] || 0 %>
              </div>
              <div class="text-xs text-gray-500 mt-1"><%= score[:label] %></div>
              <div class="mt-3 h-1.5 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
                <div class="h-full rounded-full bg-<%= score[:color] %>-500"
                     style="width: <%= score[:value] || 0 %>%"></div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Publish actions -->
        <div class="card p-6 space-y-4">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Publishing Options</h3>
          <div class="flex flex-wrap gap-3">
            <%= button_to publish_blog_path(@blog), method: :patch, class: "btn btn-primary", aria: { label: "Publish now" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Publish Now
            <% end %>

            <button type="button" onclick="document.getElementById('schedule-form').classList.toggle('hidden')" class="btn btn-secondary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Schedule
            </button>

            <%= button_to submit_review_blog_path(@blog), method: :patch, class: "btn btn-secondary" do %>
              Submit for Review
            <% end %>
          </div>

          <!-- Schedule form -->
          <div id="schedule-form" class="hidden">
            <%= form_with url: schedule_blog_path(@blog), method: :post do |sf| %>
              <div class="flex items-end gap-3 mt-3">
                <%= sf.label :scheduled_at, "Schedule for", class: "form-label sr-only" %>
                <%= sf.datetime_local_field :scheduled_at, class: "form-input",
                    min: Time.current.strftime("%Y-%m-%dT%H:%M"),
                    aria: { label: "Schedule publish date and time" } %>
                <%= sf.submit "Schedule →", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex justify-between">
          <%= link_to "← Back to Template", edit_blog_path(@blog, step: :template), class: "btn btn-secondary" %>
        </div>
      </div>
  <% end %>
</div>
