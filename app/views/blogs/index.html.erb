<% content_for :title, "My Blogs" %>

<div class="page-header">
  <div>
    <h1 class="page-title">My Blogs</h1>
    <p class="page-subtitle">Manage and publish your content</p>
  </div>
  <%= link_to new_blog_path, class: "btn btn-primary", aria: { label: "New Blog" } do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    New Blog
  <% end %>
</div>

<div class="page-content">
  <!-- Search & filters -->
  <%= search_form_for @q, url: blogs_path, html: { class: "mb-6 flex flex-wrap gap-3 items-end" } do |f| %>
    <div class="flex-1 min-w-48">
      <%= f.label :title_cont, "Search", class: "form-label" %>
      <%= f.search_field :title_cont, placeholder: "Search by title…", class: "form-input" %>
    </div>
    <div>
      <%= f.label :status_eq, "Status", class: "form-label" %>
      <%= f.select :status_eq, [["All", ""], ["Draft", "draft"], ["Review", "review"],
                                 ["Scheduled", "scheduled"], ["Published", "published"], ["Archived", "archived"]],
                   {}, class: "form-input" %>
    </div>
    <%= f.submit "Filter", class: "btn btn-secondary self-end" %>
    <%= link_to "Clear", blogs_path, class: "btn btn-secondary self-end" %>
  <% end %>

  <!-- Bulk actions form (kept separate from the table so per-row button_to forms aren't nested inside it) -->
  <%= form_with url: bulk_action_blogs_path, method: :post, id: "bulk-form" do |f| %>
    <div id="bulk-bar" class="hidden mb-4 flex items-center gap-3 bg-violet-500/10 border border-violet-500/20 rounded-xl px-4 py-3">
      <span id="selected-count" class="text-sm text-violet-700 dark:text-violet-300 font-medium">0 selected</span>
      <%= f.hidden_field :action_type, id: "bulk-action-type" %>
      <button type="button" onclick="setBulkAction('publish')" class="btn btn-success btn-sm">Publish</button>
      <button type="button" onclick="setBulkAction('archive')" class="btn btn-secondary btn-sm">Archive</button>
      <button type="button" onclick="setBulkAction('delete')"  class="btn btn-danger  btn-sm">Delete</button>
    </div>
  <% end %>

  <div class="card overflow-hidden">
      <% if @blogs.any? %>
        <table class="data-table" aria-label="Blog posts">
          <thead>
            <tr>
              <th class="w-10">
                <input type="checkbox" id="select-all" aria-label="Select all" class="rounded border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-violet-600 focus:ring-violet-500">
              </th>
              <th>Title</th>
              <th>Topics</th>
              <th>Status</th>
              <th class="text-right">SEO</th>
              <th class="text-right">Words</th>
              <th class="text-right">Created</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @blogs.each do |blog| %>
              <tr>
                <td>
                  <input type="checkbox" name="blog_ids[]" value="<%= blog.id %>" form="bulk-form"
                         aria-label="Select <%= blog.title %>"
                         class="blog-checkbox rounded border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-violet-600 focus:ring-violet-500">
                </td>
                <td>
                  <div class="flex flex-col">
                    <% if blog.published_status? %>
                      <%= link_to blog.title, public_blog_url_for(blog), target: "_blank", rel: "noopener",
                            class: "font-medium text-gray-900 dark:text-white hover:text-violet-600 dark:hover:text-violet-400 truncate max-w-xs" %>
                    <% else %>
                      <%= link_to blog.title, edit_blog_path(blog),
                            class: "font-medium text-gray-900 dark:text-white hover:text-violet-600 dark:hover:text-violet-400 truncate max-w-xs" %>
                    <% end %>
                    <span class="text-xs text-gray-500 mt-0.5">/<%= blog.slug %></span>
                  </div>
                </td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    <% blog.topics.first(3).each do |topic| %>
                      <span class="badge badge-published"><%= topic.name %></span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <span class="badge-<%= blog.status %>"><%= blog.status.capitalize %></span>
                </td>
                <td class="text-right">
                  <span class="<%= blog.seo_score.to_i >= 60 ? 'text-emerald-400' : 'text-gray-500' %> font-medium text-sm">
                    <%= blog.seo_score || '—' %>
                  </span>
                </td>
                <td class="text-right text-gray-600 dark:text-gray-400 text-sm"><%= number_with_delimiter(blog.word_count) %></td>
                <td class="text-right text-gray-500 text-xs"><%= blog.created_at.strftime("%b %d, %Y") %></td>
                <td class="text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to edit_blog_path(blog), class: "btn btn-secondary btn-sm", aria: { label: "Edit #{blog.title}" } do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    <% end %>
                    <% unless blog.published_status? %>
                      <%= button_to publish_blog_path(blog), method: :patch, class: "btn btn-success btn-sm", aria: { label: "Publish #{blog.title}" } do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <% end %>
                    <% end %>
                    <%= button_to blog_path(blog), method: :delete, data: { turbo_confirm: "Delete \"#{blog.title}\"?" }, class: "btn btn-danger btn-sm", aria: { label: "Delete #{blog.title}" } do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <%= render "shared/pagy_nav", pagy: @pagy if @pagy.pages > 1 %>
      <% else %>
        <div class="py-20 text-center">
          <div class="w-16 h-16 rounded-2xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9"/></svg>
          </div>
          <p class="text-gray-700 dark:text-gray-300 font-medium">No blogs yet</p>
          <p class="text-gray-500 dark:text-gray-500 text-sm mt-1">Create your first blog post to get started.</p>
          <%= link_to "Create Blog", new_blog_path, class: "btn btn-primary mt-4 mx-auto" %>
        </div>
      <% end %>
  </div>
</div>

<script>
  // Bulk selection
  const selectAll = document.getElementById('select-all');
  const checkboxes = document.querySelectorAll('.blog-checkbox');
  const bulkBar = document.getElementById('bulk-bar');
  const countEl = document.getElementById('selected-count');

  function updateBulkBar() {
    const checked = document.querySelectorAll('.blog-checkbox:checked').length;
    bulkBar.classList.toggle('hidden', checked === 0);
    countEl.textContent = checked + ' selected';
  }

  selectAll?.addEventListener('change', function() {
    checkboxes.forEach(cb => cb.checked = this.checked);
    updateBulkBar();
  });
  checkboxes.forEach(cb => cb.addEventListener('change', updateBulkBar));

  function setBulkAction(action) {
    document.getElementById('bulk-action-type').value = action;
    if (confirm('Apply "' + action + '" to selected blogs?')) {
      document.getElementById('bulk-form').submit();
    }
  }
</script>
