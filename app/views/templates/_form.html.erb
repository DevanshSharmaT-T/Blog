<%= form_with model: @template, html: { class: "space-y-5" } do |f| %>

  <% if @template.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4" role="alert">
      <p class="text-red-600 dark:text-red-400 font-medium text-sm mb-2">Please fix the following errors:</p>
      <ul class="list-disc list-inside text-red-700 dark:text-red-300 text-sm space-y-1">
        <% @template.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-6 space-y-4">
    <div class="form-group" data-controller="slug">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input", required: true, maxlength: 120,
            data: { slug_target: "titleInput", action: "input->slug#titleChanged" } %>
    </div>

    <div class="form-group">
      <%= f.label :slug, class: "form-label" %>
      <%= f.text_field :slug, class: "form-input", placeholder: "auto-generated-from-name" %>
      <p class="form-hint">Lowercase letters, digits, and hyphens only.</p>
    </div>

    <div class="form-group">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-input", rows: 3 %>
    </div>

    <div class="form-group">
      <%= f.label :category, class: "form-label" %>
      <%= f.select :category,
            options_for_select(
              [["Minimal", "minimal"], ["Magazine", "magazine"], ["Feature", "feature"], ["Custom", "custom"]],
              @template.category
            ),
            { include_blank: "— Select —" },
            class: "form-input" %>
    </div>
  </div>

  <div class="card p-6 space-y-4" data-controller="cover-preview image-upload">
    <%= f.label :thumbnail_url, "Thumbnail", class: "form-label" %>

    <div data-image-upload-target="dropzone"
         class="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-5 text-center cursor-pointer hover:border-violet-400 dark:hover:border-violet-500 transition-colors"
         data-action="click->image-upload#pickFile">
      <p class="text-sm text-gray-600 dark:text-gray-400">Drag &amp; drop or <span class="text-violet-600 dark:text-violet-400 underline">browse</span></p>
      <input type="file" accept="image/*" class="hidden"
             data-image-upload-target="fileInput"
             data-action="change->image-upload#fileChosen">
    </div>
    <div data-image-upload-target="spinner" class="hidden text-sm text-violet-600 dark:text-violet-400">Uploading…</div>
    <div data-image-upload-target="error"   class="hidden text-sm text-red-500 dark:text-red-400"></div>

    <%= f.text_field :thumbnail_url, class: "form-input", placeholder: "https://…",
          data: { cover_preview_target: "input", image_upload_target: "urlField", action: "input->cover-preview#input" } %>

    <div data-cover-preview-target="preview" class="<%= @template.thumbnail_url.present? ? '' : 'hidden' %>">
      <img data-cover-preview-target="image" data-image-upload-target="image"
           src="<%= @template.thumbnail_url %>" alt="Thumbnail preview"
           class="w-full h-44 object-cover rounded-xl border border-gray-200 dark:border-gray-700">
    </div>

    <div class="form-group">
      <%= f.label :preview_url, "Live Preview URL", class: "form-label" %>
      <%= f.url_field :preview_url, class: "form-input", placeholder: "https://…" %>
    </div>
  </div>

  <div class="card p-6 space-y-4">
    <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Layout Config (JSON)</h3>
    <p class="form-hint">Raw JSON describing the template's layout regions, typography, and color scheme.</p>
    <%= f.text_area :layout_config_raw,
          value: @template.layout_config.is_a?(Hash) ? JSON.pretty_generate(@template.layout_config) : @template.layout_config.to_s,
          class: "form-input font-mono text-xs",
          rows: 10,
          placeholder: '{ "hero": "centered", "font": "merriweather" }' %>
  </div>

  <div class="card p-6 space-y-3">
    <label class="flex items-center gap-3">
      <%= f.check_box :is_premium, class: "rounded border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-violet-600 focus:ring-violet-500" %>
      <span class="text-sm text-gray-800 dark:text-gray-200">Premium template</span>
    </label>
    <label class="flex items-center gap-3">
      <%= f.check_box :is_active, class: "rounded border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-violet-600 focus:ring-violet-500" %>
      <span class="text-sm text-gray-800 dark:text-gray-200">Active (visible to writers)</span>
    </label>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", templates_path, class: "btn btn-secondary" %>
    <%= f.submit (@template.persisted? ? "Update Template" : "Create Template"), class: "btn btn-primary" %>
  </div>
<% end %>
