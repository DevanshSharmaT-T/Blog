<header class="public-header" data-controller="theme">
  <div class="public-header-inner">
    <%= link_to root_path, class: "public-header-brand" do %>
      <span class="logo">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
      </span>
      <span>MyBlog</span>
    <% end %>

    <nav class="public-header-nav" aria-label="Primary">
      <%= link_to "Posts",  blog_archive_path, class: ("active" if controller_name == "blogs" && action_name == "archive") %>
      <%= link_to "Topics", topics_path,       class: ("active" if controller_name == "topics") %>
    </nav>

    <div class="public-header-actions">
      <button type="button" class="theme-toggle" data-action="theme#toggle" aria-label="Toggle color theme">
        <svg class="icon-sun w-4 h-4"  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg class="icon-moon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>

      <% if user_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "btn btn-secondary btn-sm" %>
      <% else %>
        <%= link_to "Sign in",   new_user_session_path,      class: "btn btn-secondary btn-sm" %>
        <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</header>
