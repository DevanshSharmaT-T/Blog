<nav class="fixed inset-y-0 left-0 w-64 bg-white dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 flex flex-col z-40" aria-label="Main navigation">
  <!-- Brand -->
  <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-200 dark:border-gray-800">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-md shadow-violet-500/30">
      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
    </div>
    <span class="font-bold text-gray-900 dark:text-white text-lg tracking-tight">MyBlog</span>
  </div>

  <!-- Navigation links -->
  <div class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <% if current_user.owner_role? || current_user.admin_role? %>
      <%= link_to dashboard_path, class: "nav-link #{current_page?(dashboard_path) ? 'nav-link-active' : ''}", aria: { label: "Dashboard" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      <% end %>
    <% end %>

    <p class="px-3 pt-4 pb-1 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wider">Content</p>

    <%= link_to blogs_path, class: "nav-link #{controller_name == 'blogs' ? 'nav-link-active' : ''}", aria: { label: "Blogs" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      My Blogs
    <% end %>

    <%= link_to new_blog_path, class: "nav-link #{action_name == 'new' && controller_name == 'blogs' ? 'nav-link-active' : ''}", aria: { label: "New Blog" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Blog
    <% end %>

    <%= link_to topics_path, class: "nav-link #{controller_name == 'topics' ? 'nav-link-active' : ''}", aria: { label: "Topics" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      Topics
    <% end %>

    <%= link_to templates_path, class: "nav-link #{controller_name == 'templates' ? 'nav-link-active' : ''}", aria: { label: "Templates" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 8a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zm12 0a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
      Templates
    <% end %>

    <% if current_user.owner_role? || current_user.admin_role? %>
      <p class="px-3 pt-4 pb-1 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wider">Admin</p>

      <%= link_to users_path, class: "nav-link #{controller_name == 'users' ? 'nav-link-active' : ''}", aria: { label: "Users" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Users
      <% end %>
    <% end %>

    <p class="px-3 pt-4 pb-1 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wider">Settings</p>

    <%= link_to settings_profile_path, class: "nav-link #{controller.class.name.include?('Profile') ? 'nav-link-active' : ''}", aria: { label: "Profile" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Profile
    <% end %>

    <%= link_to settings_socials_path, class: "nav-link #{controller.class.name.include?('Socials') ? 'nav-link-active' : ''}", aria: { label: "Connected Accounts" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Connected Accounts
    <% end %>

    <% if current_user.owner_role? %>
      <%= link_to settings_integrations_path, class: "nav-link #{controller.class.name.include?('Integrations') ? 'nav-link-active' : ''}", aria: { label: "Integrations" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Integrations
      <% end %>

      <%= link_to settings_webhooks_path, class: "nav-link #{controller.class.name.include?('Webhooks') ? 'nav-link-active' : ''}", aria: { label: "Webhooks" } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 002-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Webhooks
      <% end %>
    <% end %>
  </div>

  <!-- Theme toggle + user profile at bottom -->
  <div class="px-3 py-3 border-t border-gray-200 dark:border-gray-800" data-controller="theme">
    <button type="button" class="theme-toggle w-full" data-action="theme#toggle" aria-label="Toggle color theme">
      <svg class="icon-sun w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <svg class="icon-moon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      <span class="ml-2 text-xs">Theme</span>
    </button>
  </div>

  <div class="border-t border-gray-200 dark:border-gray-800 px-3 py-4">
    <div class="flex items-center gap-3 px-3 py-2">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-violet-400 to-indigo-500 flex items-center justify-center text-white text-sm font-semibold shrink-0">
        <%= current_user.name[0].upcase %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= current_user.name %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= current_user.role.capitalize %></p>
      </div>
    </div>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-500/10 mt-1", aria: { label: "Sign out" } do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Sign Out
    <% end %>
  </div>
</nav>
